# Ready-made settings for local development with docker-compose.yml.
# Copy this file to ".env" (see README, "Run it locally") — nothing else to edit.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=local-development-secret-not-for-production

# Where a "day" ends for the activity chart. Use your own IANA timezone (e.g. Asia/Kolkata, Europe/London).
APP_TIMEZONE=UTC

# --- PostgreSQL (container "portal-postgres") ---
DATABASE_URL=postgresql://portal:portal_dev_pw@localhost:5432/company_portal

# --- File storage (container "portal-storage") ---
# Must stay http://localhost:9000: your browser follows the download links, so it has to be able to reach this address.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=company-portal-files
S3_ACCESS_KEY_ID=portaladmin
S3_SECRET_ACCESS_KEY=portaladmin-secret
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# --- First admin account (created automatically on first start) ---
ADMIN_NAME=Company Admin
ADMIN_EMAIL=admin@startover.local
ADMIN_PASSWORD=Admin@12345

# --- E-mail: leave empty for local use (verification links are shown on screen) ---
SMTP_HOST=
