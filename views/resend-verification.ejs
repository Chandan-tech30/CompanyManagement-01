<!DOCTYPE html>
<html lang="en">
<head><%- include('./partials/head', { title }) %></head>
<body>
  <div class="auth-page employee-theme">
    <div class="orb orb-a"></div>
    <div class="orb orb-b"></div>
    <div class="auth-card">
      <a class="back-link" href="/login/employee"><%- icon('arrowLeft', 16) %> Back to login</a>
      <div class="auth-brand"><%- icon('message', 20) %><span>Resend verification email</span></div>
      <p class="auth-hint">Enter the email you registered with and we'll send a fresh verification link.</p>

      <form method="POST" action="/resend-verification" class="auth-form">
        <div class="form-group">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autofocus placeholder="you@example.com">
        </div>
        <button class="btn btn-primary btn-block" type="submit">Send link</button>
      </form>
    </div>
  </div>
</body>
</html>
