<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title + ' · ' + company.name : company.name %></title>
<link rel="icon" type="image/svg+xml" href="/images/startover-logo.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<script>
  // Apply the saved look before first paint (no flash): "system" theme + hidden sidebar.
  (function () {
    var d = document.documentElement;
    if (d.getAttribute('data-theme-pref') === 'system') {
      d.setAttribute('data-theme', window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    }
    try { if (localStorage.getItem('sidebarHidden') === '1') d.setAttribute('data-sidebar-hidden', '1'); } catch (e) {}
  })();
</script>
<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.16.2/dist/cdn.min.js"></script>
<% if (typeof currentUser !== 'undefined' && currentUser) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script src="/socket.io/socket.io.js"></script>
<% } %>
<script src="/js/app.js"></script>
