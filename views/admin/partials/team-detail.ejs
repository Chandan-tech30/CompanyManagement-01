<a class="back-link" href="/admin/tab/teams" hx-get="/admin/tab/teams" hx-target="#main-panel" hx-swap="innerHTML" hx-push-url="true">
  <%- icon('arrowLeft', 16) %> All teams
</a>

<div id="team-root" data-team-id="<%= team.id %>" data-role="admin">
  <%- include('./team-head') %>

  <div class="work-layout">
    <div class="work-col">
      <h3 class="col-title">Assignments &amp; submissions</h3>
      <%- include('./team-assignments') %>
    </div>
    <div class="work-col">
      <h3 class="col-title">Team chat</h3>
      <%- include('../../partials/chat-panel', { chat }) %>
    </div>
  </div>
</div>
