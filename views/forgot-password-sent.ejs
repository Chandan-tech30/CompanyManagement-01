<!DOCTYPE html>
<html lang="en">
<head><%- include('./partials/head', { title }) %></head>
<body>
  <div class="auth-page <%= role === 'admin' ? 'admin-theme' : 'employee-theme' %>">
    <div class="orb orb-a"></div>
    <div class="orb orb-b"></div>
    <div class="auth-card">
      <div class="auth-brand"><%- icon('message', 20) %><span>Check your email</span></div>
      <p class="auth-hint">If an account exists for <strong><%= email %></strong>, we've sent a link to reset the password. It expires in 1 hour and works once.</p>

      <% if (devLink) { %>
        <div class="dev-callout">
          <strong>Dev mode</strong> - no SMTP is configured, so here's the link directly:
          <a href="<%= devLink %>"><%= devLink %></a>
        </div>
      <% } %>

      <p class="auth-switch"><a href="/login/<%= role %>">Back to login</a></p>
    </div>
  </div>
</body>
</html>
