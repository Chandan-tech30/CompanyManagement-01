<!DOCTYPE html>
<html lang="en">
<head><%- include('./partials/head', { title }) %></head>
<body>
  <div class="auth-page <%= role === 'admin' ? 'admin-theme' : 'employee-theme' %>">
    <div class="orb orb-a"></div>
    <div class="orb orb-b"></div>
    <div class="auth-card">
      <a class="back-link" href="/login/<%= role %>"><%- icon('arrowLeft', 16) %> Back to login</a>
      <div class="auth-brand"><%- icon('lock', 20) %><span>Forgot your password?</span></div>
      <p class="auth-hint">Enter the email on your <%= role %> account and we'll send you a link to set a new password. The link is valid for 1 hour.</p>

      <% if (typeof flash !== 'undefined' && flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>

      <form method="POST" action="/forgot-password" class="auth-form">
        <input type="hidden" name="role" value="<%= role %>">
        <div class="form-group">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autofocus placeholder="<%= role === 'admin' ? 'admin@company.local' : 'you@example.com' %>">
        </div>
        <button class="btn btn-primary btn-block" type="submit">Send reset link</button>
      </form>
      <p class="auth-switch-alt">
        <% if (role === 'admin') { %><a href="/forgot-password?role=employee">Employee account instead? &rarr;</a>
        <% } else { %><a href="/forgot-password?role=admin">Admin account instead? &rarr;</a><% } %>
      </p>
    </div>
  </div>
</body>
</html>
