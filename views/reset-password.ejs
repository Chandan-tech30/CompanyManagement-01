<!DOCTYPE html>
<html lang="en">
<head><%- include('./partials/head', { title }) %></head>
<body>
  <div class="auth-page employee-theme">
    <div class="orb orb-a"></div>
    <div class="orb orb-b"></div>
    <div class="auth-card">
      <div class="auth-brand"><%- icon('lock', 20) %><span>Choose a new password</span></div>

      <% if (typeof flash !== 'undefined' && flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>

      <form method="POST" action="/reset-password/<%= token %>" class="auth-form" autocomplete="off">
        <div class="form-group">
          <label for="password">New password</label>
          <input id="password" name="password" type="password" required minlength="8" autofocus placeholder="At least 8 characters" autocomplete="new-password">
        </div>
        <div class="form-group">
          <label for="confirm_password">Confirm new password</label>
          <input id="confirm_password" name="confirm_password" type="password" required minlength="8" placeholder="Repeat it" autocomplete="new-password">
        </div>
        <p class="field-hint">This signs you out everywhere else your account is logged in.</p>
        <button class="btn btn-primary btn-block" type="submit">Set new password</button>
      </form>
    </div>
  </div>
</body>
</html>
