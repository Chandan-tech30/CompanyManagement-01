<!DOCTYPE html>
<html lang="en">
<head><%- include('./partials/head', { title }) %></head>
<body>
  <div class="auth-page admin-theme">
    <div class="orb-field" id="orbField">
      <div class="orb orb-a"></div>
      <div class="orb orb-b"></div>
    </div>
    <div class="auth-card">
      <a class="back-link" href="/"><%- icon('arrowLeft', 16) %> Back</a>
      <%- include('./partials/brand-hero', { heroSize: 40 }) %>
      <p class="auth-hint">Admin login - single administrator access.</p>

      <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>

      <form method="POST" action="/login/admin" class="auth-form">
        <div class="form-group">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autofocus placeholder="admin@company.local">
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" required placeholder="Your password">
        </div>
        <button class="btn btn-primary btn-block" type="submit">Log in</button>
      </form>
      <p class="auth-switch"><a href="/forgot-password?role=admin">Forgot your password?</a></p>
      <p class="auth-switch-alt"><a href="/login/employee">Employee instead? &rarr;</a></p>
    </div>
  </div>
</body>
</html>
