# ======================================================================
#  StartOver Company Portal — environment variables
#  Copy to .env for local development. On Render, set these in
#  Dashboard → your service → Environment (never commit real values).
# ======================================================================

NODE_ENV=development
PORT=3000
# Public URL of the site. Used for verification e-mails and the
# "copy link" button on announcements.
APP_BASE_URL=http://localhost:3000

# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# REQUIRED in production. Sessions live in PostgreSQL, so logins survive restarts / Render sleep.
SESSION_SECRET=change-this-to-a-long-random-string

# IANA timezone that defines "a day" for the daily-activity chart (e.g. Asia/Kolkata, Europe/London, America/New_York).
APP_TIMEZONE=UTC

# ---------------------------------------------------------------- PostgreSQL
# Any Postgres: Neon, Supabase, Render Postgres, local...
DATABASE_URL=postgresql://user:password@localhost:5432/company_portal
# SSL is on automatically for non-local hosts. Set to "false" to turn it off.
# DATABASE_SSL=false
# Keep the pool small on free database tiers.
# PG_POOL_MAX=8

# ---------------------------------------------------- Object storage (S3 API)
# Works with Cloudflare R2, AWS S3, Backblaze B2, MinIO, Supabase Storage (S3 endpoint)...
# The bucket can (and should) stay PRIVATE — the app hands out short-lived signed links
# only to people who are allowed to see a file.
S3_BUCKET=company-portal-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cloudflare R2:  https://<ACCOUNT_ID>.r2.cloudflarestorage.com   (region: auto)
# AWS S3:         leave S3_ENDPOINT empty and set S3_REGION (e.g. ap-south-1)
# Local Docker storage (docker-compose.yml): http://localhost:9000  with S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
# Local development only: create the bucket automatically if it does not exist yet.
# S3_AUTO_CREATE_BUCKET=true

# Upload limits (files are buffered in memory before going to storage;
# Render Free has 512 MB RAM, so keep these modest).
MAX_UPLOAD_MB=25
MAX_MEDIA_MB=50
MAX_FILES_PER_UPLOAD=50

# ------------------------------------------------------- First admin account
# Created automatically on first boot if no admin exists yet
# (Render Free has no shell, so there is no need to run `npm run seed` there).
ADMIN_NAME=Company Admin
ADMIN_EMAIL=admin@startover.local
ADMIN_PASSWORD=Admin@12345

# ---------------------------------------------------------- E-mail (optional)
# Blank = verification links are printed in the server log and shown on-screen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@startover.local
